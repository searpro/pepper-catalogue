      "mode": "video",
      "capabilities": ["s2v"],
      "s2v": {
        "frames_per_chunk": 121,
        "chunk_seconds": 4.84,
        "overlap_seconds": 0.4,
        "frame_grid": { "stride": 4, "offset": 1 },
        "sample_rate": 16000,
        "chain_frames": true
      },
      "defaults": {
        "steps": 8,
        "cfg_scale": 6,
        "width": 512,
        "height": 512,
        "video_frames": 121,
        "fps": 25
      },
      "components": [
        {
          "slot": "checkpoint",
